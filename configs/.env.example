# Configuration pour Docker Compose
# Copiez ce fichier en .env et modifiez les valeurs selon vos besoins

# Port pour Ollama (API)
OLLAMA_PORT=11434
# Port pour Open WebUI (interface graphique)
OPEN_WEBUI_PORT=8080
# URL de base pour Ollama (utilisé par Open WebUI)
OLLAMA_BASE_URL=http://localhost:11434
# Désactiver l'authentification pour Open WebUI (True/False)
WEBUI_AUTH=False
# Nom de l'interface
WEBUI_NAME=Local_LLM_IA
